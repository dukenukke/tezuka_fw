#!/bin/sh

. /usr/lib/tezuka/service-env.sh

DAEMON=/usr/bin/serial_ws
PIDFILE=/var/run/serial-ws.pid

case "$1" in
	start)
		if ! service_env_enabled serial_ws; then
			service_env_skip serial_ws "Pluto WebSocket/UART bridge"
			exit 0
		fi
		printf 'Starting Pluto WebSocket/UART bridge: '
		# serial_ws owns ttyPS0 exclusively, so disable its login console.
		# When serial_ws=off this script exits above and the console stays enabled.
		sed -i '/^ttyPS0::respawn:/d' /etc/inittab
		if start-stop-daemon -S -b -q -m -p "$PIDFILE" -x "$DAEMON" -- \
			-d /dev/ttyPS0 -p 7683 -r /serial; then
			echo OK
		else
			echo FAIL
		fi
		;;
	stop)
		printf 'Stopping Pluto WebSocket/UART bridge: '
		if start-stop-daemon -K -q -p "$PIDFILE" -x "$DAEMON"; then
			rm -f "$PIDFILE"
			echo OK
		else
			echo FAIL
		fi
		;;
	restart|reload)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
