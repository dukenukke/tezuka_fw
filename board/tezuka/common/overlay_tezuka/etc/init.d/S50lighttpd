#!/bin/sh

. /usr/lib/tezuka/service-env.sh

DAEMON=/usr/sbin/lighttpd
PIDFILE=/var/run/lighttpd.pid
CONFIG=/etc/lighttpd/lighttpd.conf

start() {
	[ -x "$DAEMON" ] || return 0
	if ! service_env_enabled enable_lighttpd; then
		service_env_skip enable_lighttpd lighttpd
		return 0
	fi
	printf "Starting lighttpd: "
	start-stop-daemon -S -q -p "$PIDFILE" -x "$DAEMON" -- -f "$CONFIG"
	status=$?
	[ "$status" -eq 0 ] && echo OK || echo FAIL
	return "$status"
}

stop() {
	[ -x "$DAEMON" ] || return 0
	printf "Stopping lighttpd: "
	start-stop-daemon -K -q -o -p "$PIDFILE" -x "$DAEMON"
	status=$?
	[ "$status" -eq 0 ] && echo OK || echo FAIL
	rm -f "$PIDFILE"
	return "$status"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart|reload}"; exit 1 ;;
esac
