#!/bin/sh

DAEMON="/usr/bin/plutorx_ws"
PIDFILE="/var/run/plutorx_ws.pid"

wait_for_iio() {
	retries=20
	while [ "$retries" -gt 0 ]; do
		find /sys/bus/iio/devices -name name -exec grep -ql "^ad9361-phy$" {} + 2>/dev/null && return 0
		retries=$((retries - 1))
		sleep 1
	done
	return 1
}

start() {
	PORT="${PLUTORX_WS_PORT:-7682}"
	URI="${PLUTORX_WS_URI:-/iq}"

	if [ -n "$PLUTORX_WS_OPTS" ]; then
		OPTS="$PLUTORX_WS_OPTS"
	else
		OPTS="-p $PORT -r $URI"
	fi

	printf "Starting plutorx_ws: "
	if [ ! -x "$DAEMON" ]; then
		echo "FAIL ($DAEMON not found)"
		return 1
	fi

	if ! wait_for_iio; then
		echo "FAIL (ad9361-phy IIO device not found)"
		return 1
	fi

	if start-stop-daemon -S -b -q -m -p "$PIDFILE" -x "$DAEMON" -- $OPTS; then
		echo "OK"
	else
		echo "FAIL"
		return 1
	fi
}

stop() {
	printf "Stopping plutorx_ws: "
	if start-stop-daemon -K -q -p "$PIDFILE" 2>/dev/null; then
		echo "OK"
	else
		echo "FAIL"
		return 1
	fi
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit $?
