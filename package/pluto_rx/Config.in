config BR2_PACKAGE_PLUTO_RX
	bool "pluto_rx tools"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_LIBIIO
	select BR2_PACKAGE_CIVETWEBWS
	select BR2_PACKAGE_CIVETWEBWS_LIB
	help
	  Build the Pluto RX sample streaming tools.

	  This installs the plutorx command-line streaming tool. Raw CS8 IQ
	  WebSocket streaming is provided by maia-httpd at /iq.

comment "pluto_rx tools need a toolchain w/ threads"
	depends on !BR2_TOOLCHAIN_HAS_THREADS
