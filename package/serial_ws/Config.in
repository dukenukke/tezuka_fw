config BR2_PACKAGE_SERIAL_WS
	bool "serial WebSocket bridge"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_CIVETWEBWS
	select BR2_PACKAGE_CIVETWEBWS_LIB
	help
	  Bidirectional binary WebSocket bridge for a serial device.

comment "serial WebSocket bridge needs a toolchain w/ threads"
	depends on !BR2_TOOLCHAIN_HAS_THREADS
